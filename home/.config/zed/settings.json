{
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "collaboration_panel": {
    "button": false
  },
  "preview_tabs": {
    "enable_preview_multibuffer_from_code_navigation": false,
    "enable_preview_from_multibuffer": false,
    "enable_keep_preview_on_code_navigation": false,
    "enable_preview_from_file_finder": true
  },
  "markdown_preview_code_font_family": "M+1Code Nerd Font",
  "markdown_preview_font_family": "M+1Code Nerd Font",
  "outline_panel": {
    "button": false,
    "indent_size": 16.0
  },
  "debugger": {
    "dock": "right"
  },
  "active_pane_modifiers": {
    "inactive_opacity": 0.8,
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "skill": {
          "default": "allow"
        }
      }
    },
    "default_profile": "write",
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
      "effort": "high"
    },
    "favorite_models": [
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-terra",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-luna",
        "enable_thinking": true,
        "effort": "medium"
      }
    ],
    "sidebar_side": "left",
    "auto_compact": {
      "threshold": "90%"
    },
    "dock": "left",
    "enable_feedback": false,
    "expand_terminal_card": false,
    "play_sound_when_agent_done": "when_hidden",
    "show_turn_stats": true,
    "thinking_display": "always_collapsed",
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "high"
      },
      "type": "registry"
    },
  },
  "auto_install_extensions": {
    "deno": true,
    "dockerfile": true,
    "github-theme": true,
    "html": true,
    "less": true,
    "lua": true,
    "scss": true,
    "toml": true,
    "tsgo": true,
  },
  "buffer_font_family": "M+1Code Nerd Font",
  "buffer_font_size": 16.0,
  "diff_view_style": "unified",
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "git": {
    "hunk_style": "unstaged_hollow",
    "inline_blame": {
      "enabled": false,
    },
  },
  "git_panel": {
    "entry_primary_click_action": "file_diff",
    "group_by": "staging",
    "scrollbar": {
      "show": "auto",
    },
    "status_style": "label_color",
    "tree_view": true,
  },
  "gutter": {
    "breakpoints": false,
    "folds": false,
    "min_line_number_digits": 3,
    "runnables": false,
  },
  "inline_code_actions": false,
  "languages": {
    "JavaScript": {
      "code_actions_on_format": { "source.fixAll.eslint": true },
      "format_on_save": "off",
      "formatter": "none",
      "language_servers": ["tsgo", "eslint", "!prettier"],
    },
    "TSX": {
      "code_actions_on_format": { "source.fixAll.eslint": true },
      "format_on_save": "off",
      "formatter": "none",
      "language_servers": ["tsgo", "eslint", "!prettier"],
    },
    "TypeScript": {
      "code_actions_on_format": { "source.fixAll.eslint": true },
      "format_on_save": "off",
      "formatter": "none",
      "language_servers": ["tsgo", "eslint", "!prettier"],
    },
  },
  "lsp": {
    "eslint": {
      "settings": {
        "nodePath": ".yarn/sdks",
        "workingDirectory": {
          "mode": "auto",
        },
      },
    },
  },
  "project_panel": {
    "git_status_indicator": true,
    "diagnostic_badges": true,
    "bold_folder_labels": false,
    "indent_size": 16.0,
    "entry_spacing": "standard",
    "hide_gitignore": false,
    "hide_root": true,
    "scrollbar": { "show": "auto" },
  },
  "scrollbar": {
    "cursors": false,
    "selected_symbol": false,
    "selected_text": false,
    "show": "always",
  },
  "show_edit_predictions": false,
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "show_diagnostics": "all",
    "git_status": true,
    "file_icons": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "dock": "bottom",
    "default_height": 400,
    "font_family": "M+1Code Nerd Font",
    "font_size": 16.0,
    "line_height": "standard",
    "scrollbar": {
      "show": "auto",
    },
  },
  "theme": {
    "dark": "GitHub Dark Colorblind",
    "light": "GitHub Light Colorblind",
    "mode": "light",
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
  },
  "ui_font_family": "M+1Code Nerd Font",
  "ui_font_size": 16.0,
  "unnecessary_code_fade": 0.5,
  "vertical_scroll_margin": 999,
  "vim": {
    "highlight_on_yank_duration": 250,
    "use_system_clipboard": "always",
  },
  "vim_mode": false,
}
